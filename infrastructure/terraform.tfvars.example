# Copy to terraform.tfvars (ignored). These are non-secret placeholders only.
aws_account_id  = "000000000000"
certificate_arn = "arn:aws:acm:eu-central-1:000000000000:certificate/REPLACE_ME"
environment     = "prd"
domain_name     = "gratilo.com"
mail_from_email = "noreply@gratilo.com"
image_tag       = "initial"
desired_count   = 0
# Small database to start; two NAT gateways still incur ongoing costs.
db_instance_class = "db.t4g.micro"
db_multi_az       = false
