# Copy to terraform.tfvars (ignored). These are non-secret placeholders only.
aws_account_id  = "000000000000"
certificate_arn = "arn:aws:acm:eu-central-1:000000000000:certificate/REPLACE_ME"
environment     = "prd"
domain_name     = "gratilo.com"
mail_host       = "smtp.example.invalid"
mail_from_email = "noreply@example.invalid"
image_tag       = "initial"
desired_count   = 0
# Production defaults: two NAT gateways and Multi-AZ RDS incur ongoing costs.
db_multi_az = true
